<?xml version="1.0" encoding="utf-8"?>
<CAEXFile SchemaVersion="3.0" FileName="EFL_DomainLibrary_v0.1.0.aml" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dke.de/CAEX">
  <SuperiorStandardVersion>AutomationML 2.1</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="efl-aml-mapper" OriginID="efl-aml-mapper" OriginVersion="0.1.0" LastWritingDateTime="2026-01-01T00:00:00Z" />
  <ExternalReference Path="AutomationML_Base_Libraries_AMLEd2_2.11.0.aml" Alias="AutomationMLBaseLibrariesAMLEd22_11_0" />
  <ExternalReference Path="OMG_DD_AttributeTypeLib_v0.1.aml" Alias="OMG_DD" />
  <InterfaceClassLib Name="EFL_InterfaceClassLib">
    <Description>Connection endpoints of the Example Flow Language. The first pair is used when a flow is an InternalLink between nodes, the second group when a flow is an element of its own.</Description>
    <Version>0.1.0</Version>
    <InterfaceClass Name="EFL_Port" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLInterfaceClassLib/AutomationMLBaseInterface/Port">
      <Description>Abstract base port. Carries the docking point of a connection.</Description>
      <Version>0.1.0</Version>
      <Attribute Name="PortCoordinate" AttributeDataType="xs:string" RefAttributeType="OMG_DD@OMG_DD_AttributeTypeLib/DD_Point">
        <Attribute Name="x" AttributeDataType="xs:double" />
        <Attribute Name="y" AttributeDataType="xs:double" />
      </Attribute>
    </InterfaceClass>
    <InterfaceClass Name="EFL_FlowOut" RefBaseClassPath="EFL_InterfaceClassLib/EFL_Port">
      <Description>Outgoing end of a flow, on the source node.</Description>
      <Version>0.1.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="EFL_FlowIn" RefBaseClassPath="EFL_InterfaceClassLib/EFL_Port">
      <Description>Incoming end of a flow, on the target node.</Description>
      <Version>0.1.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="EFL_FlowEnd" RefBaseClassPath="EFL_InterfaceClassLib/EFL_Port">
      <Description>Port on a node that a flow element attaches to.</Description>
      <Version>0.1.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="EFL_FlowSource" RefBaseClassPath="EFL_InterfaceClassLib/EFL_Port">
      <Description>Source end of a flow element.</Description>
      <Version>0.1.0</Version>
    </InterfaceClass>
    <InterfaceClass Name="EFL_FlowTarget" RefBaseClassPath="EFL_InterfaceClassLib/EFL_Port">
      <Description>Target end of a flow element.</Description>
      <Version>0.1.0</Version>
    </InterfaceClass>
  </InterfaceClassLib>
  <RoleClassLib Name="EFL_RoleClassLib">
    <Description>Meaning of the Example Flow Language: what an element is, independent of how it is created.</Description>
    <Version>0.1.0</Version>
    <RoleClass Name="EFL_Diagram" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure">
      <Description>One diagram. Holds the elements of a model.</Description>
      <Version>0.1.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="EFL_AttributeTypeLib/EFL_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="EFL_Element" RefBaseClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole">
      <Description>Abstract base of every element of a diagram.</Description>
      <Version>0.1.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="EFL_AttributeTypeLib/EFL_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD@OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD@OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
    </RoleClass>
    <RoleClass Name="EFL_Step" RefBaseClassPath="EFL_RoleClassLib/EFL_Element">
      <Description>An activity that takes time.</Description>
      <Version>0.1.0</Version>
      <Attribute Name="Duration" AttributeDataType="xs:double" Unit="s">
        <DefaultValue>0</DefaultValue>
      </Attribute>
    </RoleClass>
    <RoleClass Name="EFL_Store" RefBaseClassPath="EFL_RoleClassLib/EFL_Element">
      <Description>A place where something waits.</Description>
      <Version>0.1.0</Version>
      <Attribute Name="Capacity" AttributeDataType="xs:double">
        <DefaultValue>0</DefaultValue>
      </Attribute>
    </RoleClass>
    <RoleClass Name="EFL_Flow" RefBaseClassPath="EFL_RoleClassLib/EFL_Element">
      <Description>A directed connection from one element to another. Written either as an InternalLink between interfaces of the two nodes, or as an element of its own; see the mapper's connection style.</Description>
      <Version>0.1.0</Version>
    </RoleClass>
  </RoleClassLib>
  <SystemUnitClassLib Name="EFL_SystemUnitClassLib">
    <Description>Templates instances are created from. Each one names its role class through SupportedRoleClass, so another template from a vendor catalogue can fulfil the same role.</Description>
    <Version>0.1.0</Version>
    <SystemUnitClass Name="EFL_Diagram" ID="{24472960-9774-5203-8d5d-b9508d79eaff}">
      <Version>0.1.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="EFL_AttributeTypeLib/EFL_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="EFL_RoleClassLib/EFL_Diagram" />
      <SupportedRoleClass RefRoleClassPath="AutomationMLBaseLibrariesAMLEd22_11_0@AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Structure" />
    </SystemUnitClass>
    <SystemUnitClass Name="EFL_Element" ID="{ab0d709d-249b-5de9-8c4e-3c1a56e7b9f7}">
      <Version>0.1.0</Version>
      <Attribute Name="Identification" AttributeDataType="xs:string" RefAttributeType="EFL_AttributeTypeLib/EFL_Identification">
        <Attribute Name="id" AttributeDataType="xs:string" />
        <Attribute Name="name" AttributeDataType="xs:string" />
      </Attribute>
      <Attribute Name="ViewInformation" AttributeDataType="xs:string" RefAttributeType="OMG_DD@OMG_DD_AttributeTypeLib/DD_Bounds">
        <Attribute Name="position" AttributeDataType="xs:string" RefAttributeType="OMG_DD@OMG_DD_AttributeTypeLib/DD_Point">
          <Attribute Name="x" AttributeDataType="xs:double" />
          <Attribute Name="y" AttributeDataType="xs:double" />
        </Attribute>
        <Attribute Name="width" AttributeDataType="xs:double" />
        <Attribute Name="height" AttributeDataType="xs:double" />
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="EFL_RoleClassLib/EFL_Element" />
    </SystemUnitClass>
    <SystemUnitClass Name="EFL_Step" ID="{c405c2d3-80a1-5f0c-91ec-1b078f986cd7}" RefBaseClassPath="EFL_SystemUnitClassLib/EFL_Element">
      <Version>0.1.0</Version>
      <Attribute Name="Duration" AttributeDataType="xs:double" Unit="s">
        <DefaultValue>0</DefaultValue>
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="EFL_RoleClassLib/EFL_Step" />
    </SystemUnitClass>
    <SystemUnitClass Name="EFL_Store" ID="{4ac07f32-56ee-5c30-b11c-426fbc139cf4}" RefBaseClassPath="EFL_SystemUnitClassLib/EFL_Element">
      <Version>0.1.0</Version>
      <Attribute Name="Capacity" AttributeDataType="xs:double">
        <DefaultValue>0</DefaultValue>
      </Attribute>
      <SupportedRoleClass RefRoleClassPath="EFL_RoleClassLib/EFL_Store" />
    </SystemUnitClass>
    <SystemUnitClass Name="EFL_Flow" ID="{ffe6a8ba-ba82-5716-bf1a-81cca5b272b7}" RefBaseClassPath="EFL_SystemUnitClassLib/EFL_Element">
      <Version>0.1.0</Version>
      <SupportedRoleClass RefRoleClassPath="EFL_RoleClassLib/EFL_Flow" />
    </SystemUnitClass>
  </SystemUnitClassLib>
  <AttributeTypeLib Name="EFL_AttributeTypeLib">
    <Description>Data types of the Example Flow Language.</Description>
    <Version>0.1.0</Version>
    <AttributeType Name="EFL_Identification" AttributeDataType="xs:string">
      <Description>The element's own identifier and name, as the language means them.</Description>
      <Version>1.0.0</Version>
      <Attribute Name="id" AttributeDataType="xs:string" />
      <Attribute Name="name" AttributeDataType="xs:string" />
    </AttributeType>
  </AttributeTypeLib>
