<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A clean starter builds without warnings; a new one is yours. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AutomationML engine. Everything CAEX goes through it. -->
    <PackageReference Include="Aml.Engine" Version="[4.*, 5.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared layout library, carried into every document the mapper
         creates. One copy in starter/libraries, linked here. -->
    <EmbeddedResource Include="..\..\libraries\OMG_DD_AttributeTypeLib_v0.1.aml"
                      Link="Libraries\OMG_DD_AttributeTypeLib_v0.1.aml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Efl.Tests" />
  </ItemGroup>
</Project>
